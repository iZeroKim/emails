type Query {
    "Liveness check for the GraphQL API."
    ping: String!
}

type Mutation {
    "Send an email to one or more recipients."
    sendEmail(input: SendEmailInput!): SendEmailResult!
}

input SendEmailInput {
    to: [String!]!
    subject: String!
    body: String!
    "Send the body as HTML instead of plain text."
    html: Boolean = false
}

type SendEmailResult {
    to: [String!]!
    subject: String!
    "ISO-8601 timestamp of when the message was handed to the SMTP server."
    sentAt: String!
}
